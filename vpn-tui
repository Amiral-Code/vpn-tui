    # log view ----------------------------------------------------------------
    def log_view(self, c):
        st = {"all": c is None, "off": 0, "filter": "", "cache": None}

        def lines(width):
            key = (self.m.logs.version, width, st["all"], st["filter"])
            if st["cache"] and st["cache"][0] == key:
                return st["cache"][1]
            out, day = [], None
            flt = st["filter"].lower()
            for ts, _, level, msg in self.m.logs.entries(None if st["all"] else c.uuid):
                if flt and flt not in msg.lower():
                    continue
                t = time.localtime(ts)
                if (t.tm_year, t.tm_yday) != day:
                    day = (t.tm_year, t.tm_yday)
                    out.append((f"── {time.strftime('%a %d %b %Y', t)} ──", C["acc"]))
                stamp = time.strftime("%H:%M:%S  ", t)
                for i, part in enumerate(wrap(msg, width - len(stamp))):
                    out.append(((stamp if i == 0 else " " * len(stamp)) + part, C.get(level, 0)))
            st["cache"] = (key, out)
            return out

        def body(top, left, height, width):
            title = "Log · " + ("all OpenVPN profiles" if st["all"] else c.name)
            if st["filter"]:
                title += f" · filter “{st['filter']}”"
            box(self.scr, top, left, height, width, title)
            ls = lines(width - 4)
            rows = height - 2
            st["off"] = max(0, min(st["off"], len(ls) - rows))
            end = len(ls) - st["off"]
            for i, (text, attr) in enumerate(ls[max(0, end - rows):end]):
                put(self.scr, top + 1 + i, left + 2, text, attr, width - 4)
            if not ls:
                put(self.scr, top + 1, left + 2, self.m.logs.error or "Nothing logged yet.", C["dim"])
            tag = " following " if st["off"] == 0 else f" ↑ {st['off']} lines "
            put(self.scr, top + height - 1, left + width - len(tag) - 2, tag, C["dim"])

        def key(k):
            H = self.scr.getmaxyx()[0]
            page = max(1, H - 6)
            if k in ("q", ESC, "l"):
                return True
            if k in (curses.KEY_UP, "k"):
                st["off"] += 1
            elif k in (curses.KEY_DOWN, "j"):
                st["off"] = max(0, st["off"] - 1)
            elif k in (curses.KEY_PPAGE, "b"):
                st["off"] += page
            elif k in (curses.KEY_NPAGE, " ", "f"):
                st["off"] = max(0, st["off"] - page)
            elif k in (curses.KEY_HOME, "g"):
                st["off"] = 10 ** 9
            elif k in (curses.KEY_END, "G"):
                st["off"] = 0
            elif k == "a" and c is not None:
                st["all"] = not st["all"]
            elif k == "/":
                v = self.prompt("Filter log", "Contains", st["filter"], note="Empty clears the filter.")
                if v is not None:
                    st["filter"], st["off"] = v, 0
            elif k in ("w", "y"):
                text = "\n".join(t for t, _ in lines(10 ** 6))
                if k == "y":
                    ok = copy_to_clipboard(text)
                    self.flash("Log copied to the clipboard" if ok else "No clipboard tool (wl-copy, xclip or xsel)",
                               "ok" if ok else "err")
                else:
                    name = re.sub(r"[^\w.-]+", "-", c.name if c and not st["all"] else "openvpn")
                    path = os.path.join(HOME, f"{name}-{time.strftime('%Y%m%d-%H%M%S')}.log")
                    with open(path, "w") as f:
                        f.write(text + "\n")
                    self.flash(f"Saved {path.replace(HOME, '~', 1)}", "ok")

        hints = [("↑↓", "scroll"), ("PgUp/PgDn", "page"), ("g/G", "top/follow"), ("a", "this/all"),
                 ("/", "filter"), ("w", "save"), ("y", "copy"), ("q", "back")]
        self.modal(lambda: None, key, body=body, hints=hints)

    # main loop ---------------------------------------------------------------
    def run(self):
        self.scr.timeout(250)
        if self.start_auth:
            deadline = time.time() + 5
            while time.time() < deadline and not self.find(self.start_auth):
                time.sleep(0.1)
            c = self.find(self.start_auth)
            if c:
                self.sel_uuid = c.uuid
                self.credentials(c)
        while True:
            self.handle_events()
            self.draw()
            k = self.getkey()
            if k is None or k == curses.KEY_RESIZE:
                continue
            if self.key(k) is False:
                return

    def key(self, k):
        c = self.current()
        if k in (curses.KEY_UP, "k"):
            return self.move(-1)
        if k in (curses.KEY_DOWN, "j"):
            return self.move(1)
        if k in (curses.KEY_HOME, "g"):
            return self.move(-10 ** 6)
        if k in (curses.KEY_END, "G"):
            return self.move(10 ** 6)
        action = {" ": "menu", "m": "menu", "q": "quit", ESC: "quit", "c": "connect", "d": "disconnect",
                  "r": "reconnect", "l": "log", "e": "edit", "E": "advanced", "p": "password",
                  "x": "clear", "o": "export", "b": "bar", "D": "delete", curses.KEY_DC: "delete",
                  "i": "import", "u": "import_url", "s": "settings", "?": "help"}.get(k)
        if k in ENTER:
            action = "toggle"
        if action == "menu":
            action = self.actions_menu(c)
        if action == "quit":
            return False
        if action in ("import", "import_url", "settings", "help"):
            return {"import": self.import_file, "import_url": self.import_url,
                    "settings": self.settings, "help": self.help}[action]()
        if action == "log":
            return self.log_view(c)
        if not action or not c:
            return None
        return {"toggle": self.toggle, "connect": self.connect, "disconnect": self.disconnect,
                "reconnect": self.reconnect, "edit": self.edit, "advanced": self.advanced,
                "password": self.credentials, "clear": self.clear_password, "export": self.export,
                "bar": self.set_bar, "delete": self.delete}[action](c)


# ── entry points ─────────────────────────────────────────────────────────────

def resolve(target):
    for r in list_vpns():
        if target in (r["uuid"], r["name"]):
            return r
    return None


def cli_connect(target):
    r = resolve(target)
    if not r:
        print(f"No VPN profile named '{target}'", file=sys.stderr)
        return 1
    if r["state"] in ("activated", "activating"):
        return 0
    run(["nm-online", "-q", "-t", "60"], timeout=70)  # at login, wait for Wi-Fi/Ethernet
    rc, out, err = nmcli("connection", "up", "uuid", r["uuid"])
    cfg = load_config()
    if rc == 0:
        if cfg.get("notify"):
            notify("VPN connected", r["name"])
        return 0
    msg = nm_error(out, err)
    launcher = next(([*cmd, SELF] for cmd in (["omarchy-launch-or-focus-tui"], ["xdg-terminal-exec"])
                     if shutil.which(cmd[0])), None)
    if re.search(r"secret", msg, re.I) and launcher:
        notify("VPN needs credentials", r["name"])
        subprocess.Popen([*launcher, "--auth", r["uuid"]], start_new_session=True)
    else:
        notify("VPN failed", f"{r['name']}: {msg}")
    print(msg, file=sys.stderr)
    return 1


def cli_disconnect(target):
    r = resolve(target)
    if not r:
        print(f"No VPN profile named '{target}'", file=sys.stderr)
        return 1
    if not r["state"]:
        return 0
    rc, out, err = nmcli("connection", "down", "uuid", r["uuid"], timeout=60)
    if rc:
        print(nm_error(out, err), file=sys.stderr)
    return rc


def tui(scr, args):
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    init_colors()
    scr.keypad(True)
    model = Model()
    model.poll()
    threading.Thread(target=model.run, daemon=True).start()
    try:
        App(scr, model, args).run()
    finally:
        model.stopped.set()
        model.logs.stop()


def main():
    ap = argparse.ArgumentParser(description="Manage NetworkManager OpenVPN profiles.")
    ap.add_argument("--connect", metavar="NAME", help="connect a profile and exit")
    ap.add_argument("--disconnect", metavar="NAME", help="disconnect a profile and exit")
    ap.add_argument("--auth", metavar="NAME", help="open the TUI at the credentials prompt")
    ap.add_argument("--version", action="version", version=f"vpn-tui {__version__}")
    args = ap.parse_args()
    if not shutil.which("nmcli"):
        sys.exit("vpn-tui needs NetworkManager's nmcli")
    if args.connect:
        sys.exit(cli_connect(args.connect))
    if args.disconnect:
        sys.exit(cli_disconnect(args.disconnect))
    if not sys.stdin.isatty():
        sys.exit("vpn-tui needs a terminal")
    locale.setlocale(locale.LC_ALL, "")
    os.environ.setdefault("ESCDELAY", "25")
    try:
        curses.wrapper(tui, args)
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
